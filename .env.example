APM_REQUESTS_PER_SECOND=4
APM_REQUEST_TIMEOUT_SECONDS=2
APM_HEALTHCHECK_INTERVAL_SECONDS=5
APM_HEALTHCHECK_TIMEOUT_SECONDS=1
APM_INCIDENT_METRICS_TOKEN=replace_with_a_random_scrape_token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_random_admin_password
PROMETHEUS_WEB_USERNAME=metrics-viewer
PROMETHEUS_WEB_PASSWORD=replace_with_a_random_metrics_password
OPENAI_API_KEY=replace_with_your_openai_api_key
APM_INCIDENT_METRICS_MODE=demo
APM_INCIDENT_ANALYZER_MODE=mock
APM_INCIDENT_PROMETHEUS_URL=http://localhost:9090
APM_INCIDENT_ANALYSIS_WINDOW_SECONDS=300
APM_INCIDENT_REQUEST_TIMEOUT_SECONDS=5
APM_INCIDENT_OPENAI_MODEL=gpt-5.4-mini
APM_INCIDENT_OPERATOR_AUTH_ENABLED=false
APM_INCIDENT_ENFORCE_INGRESS_NETWORKS=true
DEMO_AUTH_USER=demo-operator
DEMO_AUTH_PASSWORD=replace_with_a_random_operator_password
