global:
  scrape_interval: 5s
  evaluation_interval: 5s

rule_files:
  - /etc/prometheus/alert.rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager.railway.internal:8080

scrape_configs:
  - job_name: provider-emulator
    metrics_path: /metrics
    static_configs:
      - targets:
          - provider-emulator.railway.internal:8080

  - job_name: traffic-generator
    metrics_path: /metrics
    static_configs:
      - targets:
          - traffic-generator.railway.internal:8080

  - job_name: incident-api
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials: __APM_INCIDENT_METRICS_TOKEN__
    static_configs:
      - targets:
          - incident-api.railway.internal:8080
