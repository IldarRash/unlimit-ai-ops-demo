global:
  resolve_timeout: 2m

route:
  receiver: incident-intelligence
  group_by:
    - alertname
    - provider
  group_wait: 5s
  group_interval: 30s
  repeat_interval: 5m

receivers:
  - name: incident-intelligence
    webhook_configs:
      - url: http://incident-api.railway.internal:8002/api/v1/integrations/alertmanager
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: __APM_INCIDENT_ALERTMANAGER_TOKEN__
